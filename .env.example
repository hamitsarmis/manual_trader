# Copy to .env and fill in real values, OR set these in your shell.
# Freqtrade reads any env var matching FREQTRADE__<SECTION>__<KEY> and merges
# it into the config (double underscores separate nesting levels).
# Values set here override anything in config.json / secrets.json.

# --- Binance Futures API credentials (required for live trading) ---
FREQTRADE__EXCHANGE__KEY=
FREQTRADE__EXCHANGE__SECRET=

# --- REST API server credentials ---
FREQTRADE__API_SERVER__USERNAME=freqtrader
FREQTRADE__API_SERVER__PASSWORD=
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
FREQTRADE__API_SERVER__JWT_SECRET_KEY=

# --- Optional: Telegram notifications ---
# FREQTRADE__TELEGRAM__ENABLED=true
# FREQTRADE__TELEGRAM__TOKEN=
# FREQTRADE__TELEGRAM__CHAT_ID=
